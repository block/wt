#!/usr/bin/env bash
#
# wt-common — Shared config and helpers for wt-* scripts
# =========================================================
#
# Centralizes paths and small helpers used by the worktree tooling suite:
#   - wt-add
#   - wt-switch
#   - wt-choose
#   - wt-metadata-import
#   - wt-metadata-export
#   - wt-remove
#

# ─────────────────────────────────────────────────────────────────────────────
# Multi-repo context support
# ─────────────────────────────────────────────────────────────────────────────
# The wt toolkit supports multiple repository contexts. Each context has its
# own configuration stored in ~/.wt/repos/<name>.conf
#
# Configuration is loaded at runtime via parsing (not sourcing), so context
# switches take effect immediately without requiring shell reload.
# ─────────────────────────────────────────────────────────────────────────────

# Path helpers (defined early — used by wt_read_git_config at source time)
# ─────────────────────────────────────────────────────────────────────────────

# Resolve a path to its fully-canonicalized absolute form, following all
# symlinks in the chain. Portable alternative to `realpath` or `readlink -f`.
# Args: $1 = path to resolve
# Outputs: canonical path to stdout
# Returns: 0 on success, 1 if path does not exist
_wt_realpath() {
  local target="$1"
  while [[ -L "$target" ]]; do
    local dir="${target%/*}"
    [[ "$dir" == "$target" ]] && dir="."   # no slash in path
    [[ -z "$dir" ]] && dir="/"             # path was /filename
    dir="$(cd -P "$dir" 2>/dev/null && pwd -P)" || return 1
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  if [[ -d "$target" ]]; then
    (cd -P "$target" 2>/dev/null && pwd -P) || return 1
  elif [[ -e "$target" ]]; then
    local parent="${target%/*}"
    [[ "$parent" == "$target" ]] && parent="."   # no slash in path
    [[ -z "$parent" ]] && parent="/"             # path was /filename
    parent="$(cd -P "$parent" 2>/dev/null && pwd -P)" || return 1
    [[ "$parent" == "/" ]] && parent=""           # avoid double slash: //base
    printf '%s/%s\n' "$parent" "${target##*/}"
  else
    return 1
  fi
}

# Resolve the parent directory to its physical path, preserving the basename as-is.
# Unlike _wt_realpath, does NOT follow the final component if it's a symlink.
# Useful when you need a canonical path for comparison but must preserve a symlink
# for subsequent -L checks or readlink calls.
_wt_resolve_parent() {
  local path="$1"
  local dir="${path%/*}"
  local base="${path##*/}"
  [[ "$dir" == "$path" ]] && dir="."   # no slash in path
  [[ -z "$dir" ]] && dir="/"           # path was /filename
  dir="$(cd -P "$dir" 2>/dev/null && pwd -P)" || return 1
  [[ "$dir" == "/" ]] && dir=""        # avoid double slash: //base
  printf '%s/%s\n' "$dir" "$base"
}

# Resolve a symlink's target to an absolute path: readlink once, anchor a
# relative target at the symlink's parent directory, then canonicalize the
# parent via _wt_resolve_parent (basename preserved, not followed).
# Usage: _wt_readlink_abs <symlink>
# Outputs: absolute path to stdout
# Returns: 1 if the argument is not a symlink or resolution fails
_wt_readlink_abs() {
  local link="$1" target
  target="$(readlink "$link")" || return 1
  if [[ "$target" != /* ]]; then
    target="$(dirname "$link")/$target"
  fi
  _wt_resolve_parent "$target"
}

# Check whether a variable carries the export attribute (bash and zsh)
_wt_var_is_exported() {
  local decl flags
  decl="$(declare -p "$1" 2>/dev/null)" || return 1
  case "$decl" in
    "export "*) return 0 ;;
    "declare -"* | "typeset -"*)
      flags="${decl#* -}"
      flags="${flags%% *}"
      [[ "$flags" == *x* ]] && return 0
      ;;
  esac
  return 1
}

# Clear all WT_* config variables to allow fresh reload
# Used before wt_read_config() when we need to pick up context changes
# in the current shell (e.g., completions, help)
#
# Config loaders assign values without exporting, so a WT_* variable with
# the export attribute is a user-set override and must survive the reload.
wt_clear_config_vars() {
  local var
  for var in WT_MAIN_REPO_ROOT WT_WORKTREES_BASE WT_IDEA_FILES_BASE \
             WT_ACTIVE_WORKTREE WT_BASE_BRANCH WT_METADATA_PATTERNS \
             WT_SEED_FILES WT_CONTEXT_NAME WT_CONFIG_SOURCE; do
    _wt_var_is_exported "$var" || unset "$var"
  done
}

# Normalize a raw value parsed from a .conf line: trim surrounding
# whitespace, strip surrounding quotes, and drop anything after the
# closing quote of a quoted value (e.g. a trailing inline comment).
_wt_normalize_conf_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" == \"*\"* ]]; then
    value="${value#\"}"
    value="${value%%\"*}"
  else
    value="${value#\"}"
    value="${value%\"}"
  fi
  printf '%s\n' "$value"
}

# Read a single key's value from a .conf file (first match wins).
# Usage: wt_conf_get <conf-file> <KEY>
# Outputs: normalized value to stdout (nothing if file or key is missing)
wt_conf_get() {
  local conf_file="$1"
  local key="$2"

  [[ -f "$conf_file" ]] || return 0

  local line
  line="$(grep -E "^${key}=" "$conf_file" 2>/dev/null | head -1)" || true
  [[ -z "$line" ]] && return 0

  _wt_normalize_conf_value "${line#*=}"
}

# Get the directory where context config files are stored
# Returns: ~/.wt/repos
wt_get_repos_dir() {
  echo "$HOME/.wt/repos"
}

# Get the path to the current context file
# Returns: ~/.wt/current
wt_get_current_file() {
  echo "$HOME/.wt/current"
}

# List all available contexts (repo names)
# Outputs: one context name per line
#
# Enumerates via find instead of a glob: this function runs in zsh
# (completions), where an unmatched glob aborts under default nomatch.
wt_list_contexts() {
  local repos_dir
  repos_dir="$(wt_get_repos_dir)"

  [[ -d "$repos_dir" ]] || return 0

  local conf name
  while IFS= read -r conf; do
    [[ -f "$conf" ]] || continue
    name="${conf##*/}"
    printf '%s\n' "${name%.conf}"
  done < <(find "$repos_dir" -maxdepth 1 -name '*.conf' 2>/dev/null | sort)
}

# Get the current context name
# Returns: context name, or empty string if not set
wt_get_current_context() {
  local current_file
  current_file="$(wt_get_current_file)"

  if [[ -f "$current_file" ]]; then
    head -1 "$current_file" | tr -d '[:space:]'
  fi
}

# Parse context config file into shell variables (no sourcing)
# Only sets variables that aren't already set in the environment.
#
# Args: $1 = config file path (default: ~/.wt/current)
#
# When reading ~/.wt/current, it contains just the context name.
# The actual config is then loaded from ~/.wt/repos/<name>.conf
#
# On success records WT_CONFIG_SOURCE=context (unless a higher-priority
# source already recorded itself).
wt_read_context_config() {
  local config_file="${1:-$HOME/.wt/current}"

  [[ ! -f "$config_file" ]] && return 1

  # If this is the current context file, read context name and load from .conf
  if [[ "$config_file" == "$HOME/.wt/current" ]]; then
    local context_name
    context_name="$(head -1 "$config_file" | tr -d '[:space:]')"
    [[ -z "$context_name" ]] && return 1

    # Set context name for display purposes
    : "${WT_CONTEXT_NAME:="$context_name"}"

    # Now read the actual config from .conf file
    config_file="$HOME/.wt/repos/${context_name}.conf"
    [[ ! -f "$config_file" ]] && return 1
  fi

  local key value current_val
  while IFS='=' read -r key value; do
    # Skip empty lines and comments
    [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
    value="$(_wt_normalize_conf_value "$value")"
    # Only set if not already set in environment (allows env override)
    # Use eval with proper escaping for both bash and zsh compatibility
    eval "current_val=\"\${$key:-}\""
    if [[ -z "$current_val" ]]; then
      eval "$key=\"\$value\""
    fi
  done < <(grep -E '^WT_[A-Z_]+=' "$config_file" 2>/dev/null)

  : "${WT_CONFIG_SOURCE:=context}"
}

# Read wt.* keys from the repo's local git config.
# If CWD is inside a worktree, reads from the main repo's .git/config
# (git config --local in a worktree reads from the main repo automatically).
#
# Gated by wt.enabled=true — repos must explicitly opt in to local config.
#
# Requires three core keys (worktreesBase, ideaFilesBase, baseBranch) to be
# set. mainRepoRoot is always auto-derived from git-common-dir (the main
# repo's .git parent) and is not configurable. If partially configured,
# prints a warning to stderr and applies nothing. Optional keys
# (activeWorktree, metadataPatterns) are applied only when all required keys
# are present.
#
# Sets variables unconditionally — git local config has highest priority.
# On success records WT_CONFIG_SOURCE=git and the parsed wt.contextName
# (possibly empty) in _WT_GIT_CONTEXT_NAME.
# Returns: 0 if config was loaded, 1 if not (not in repo, not enabled,
#          no keys, or incomplete config).
wt_read_git_config() {
  # Allow tests to skip git config loading to avoid picking up the host repo's config.
  # This follows the same pattern as _wt_is_interactive override in lib/wt-adopt.
  [[ -n "${_WT_SKIP_GIT_CONFIG:-}" ]] && return 1

  # Only proceed if we're inside a git repo or worktree
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1

  # Require wt.enabled=true as an explicit opt-in
  local enabled
  enabled="$(git config --local --get wt.enabled 2>/dev/null)" || true
  [[ "$enabled" == "true" ]] || return 1

  # Read all wt.* keys into local variables
  local gc_worktrees_base="" gc_idea_files_base=""
  local gc_active_worktree="" gc_base_branch="" gc_metadata_patterns="" gc_context_name=""
  local has_any=false

  local key value line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    key="${line%% *}"
    value="${line#* }"
    has_any=true

    # git config --get-regexp prints key names lowercased (wt.* keys have
    # no case-preserving subsection), so match the raw key directly
    case "$key" in
      wt.worktreesbase)     gc_worktrees_base="$value" ;;
      wt.ideafilesbase)     gc_idea_files_base="$value" ;;
      wt.activeworktree)    gc_active_worktree="$value" ;;
      wt.basebranch)        gc_base_branch="$value" ;;
      wt.metadatapatterns)  gc_metadata_patterns="$value" ;;
      wt.contextname)       gc_context_name="$value" ;;
    esac
  done < <(git config --local --get-regexp '^wt\.' 2>/dev/null)

  # Nothing found — not a wt-configured repo
  [[ "$has_any" == "false" ]] && return 1

  # Validate: all three required keys must be present
  local -a missing=()
  [[ -z "$gc_worktrees_base" ]]  && missing+=("wt.worktreesBase")
  [[ -z "$gc_idea_files_base" ]] && missing+=("wt.ideaFilesBase")
  [[ -z "$gc_base_branch" ]]     && missing+=("wt.baseBranch")

  if [[ ${#missing[@]} -gt 0 ]]; then
    printf "wt: incomplete git local config in %s — missing: %s\n" \
      "$repo_root" "${missing[*]}" >&2
    printf "wt: git local config ignored; falling back to context config\n" >&2
    return 1
  fi

  # Derive main repo root from git-common-dir (the main repo's .git parent).
  # git-common-dir always points to the main repo's .git, even from worktrees.
  WT_MAIN_REPO_ROOT="$(_wt_realpath "$(git rev-parse --git-common-dir)/..")"

  # All required keys present — apply unconditionally (highest priority)
  WT_WORKTREES_BASE="$gc_worktrees_base"
  WT_IDEA_FILES_BASE="$gc_idea_files_base"
  WT_BASE_BRANCH="$gc_base_branch"

  # Optional keys: apply if present
  [[ -n "$gc_active_worktree" ]]   && WT_ACTIVE_WORKTREE="$gc_active_worktree"
  [[ -n "$gc_metadata_patterns" ]] && WT_METADATA_PATTERNS="$gc_metadata_patterns"
  [[ -n "$gc_context_name" ]]      && WT_CONTEXT_NAME="$gc_context_name"

  _WT_GIT_CONTEXT_NAME="$gc_context_name"
  WT_CONFIG_SOURCE="git"

  return 0
}

# Unified config loader with mode and force options.
#
# Usage: wt_read_config [--mode=(ordered|git|context)] [--force]
#
# Modes:
#   ordered  (default) — git local config first (highest priority),
#                         then context .conf fills gaps. The .conf is only
#                         consulted when the git-local wt.contextName does
#                         not name a different context than ~/.wt/current
#                         (another repo's context must not gap-fill
#                         WT_ACTIVE_WORKTREE / WT_METADATA_PATTERNS /
#                         WT_SEED_FILES here).
#   git      — git local config only (wt_read_git_config)
#   context  — context .conf only (wt_read_context_config)
#
# Flags:
#   --force  — clear all WT_* variables before loading
#
# shellcheck disable=SC2120  # args are optional; callers in other files pass --mode/--force
wt_read_config() {
  local mode="ordered"
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode=*) mode="${1#--mode=}" ;;
      --force)  force=true ;;
      *) ;;
    esac
    shift
  done

  if [[ "$force" == true ]]; then
    wt_clear_config_vars
  fi

  local rc=0 rc_git=0 rc_ctx=0

  case "$mode" in
    ordered)
      wt_read_git_config || rc_git=$?
      local gap_fill=true
      if [[ $rc_git -eq 0 && -n "${_WT_GIT_CONTEXT_NAME:-}" && -f "$HOME/.wt/current" ]]; then
        local current_name
        current_name="$(head -1 "$HOME/.wt/current" | tr -d '[:space:]')"
        if [[ -n "$current_name" && "$current_name" != "$_WT_GIT_CONTEXT_NAME" ]]; then
          gap_fill=false
        fi
      fi
      if [[ "$gap_fill" == true ]]; then
        wt_read_context_config 2>/dev/null || rc_ctx=$?
      fi
      # Fail only if both sources failed
      if [[ $rc_git -ne 0 && $rc_ctx -ne 0 ]]; then
        rc=1
      fi
      ;;
    git)
      wt_read_git_config || rc=$?
      ;;
    context)
      wt_read_context_config || rc=$?
      ;;
  esac

  # A forced reload cleared the variables, so restore the fallback defaults
  # for anything the config sources did not set (matches source-time state)
  if [[ "$force" == true ]]; then
    wt_apply_default_config
  fi

  return $rc
}

# Fallback defaults (used when no context is configured or config missing values)
# These provide backward compatibility for single-repo setups
wt_apply_default_config() {
  # Main monorepo root (where `git worktree` is managed)
  : "${WT_MAIN_REPO_ROOT:="$HOME/.wt/repos/repo/base"}"

  # Base directory where new worktrees will be created by default
  : "${WT_WORKTREES_BASE:="$HOME/.wt/repos/repo/worktrees"}"

  # Base directory for project metadata vault (IDE configs: .ijwb, .idea, .vscode, etc.)
  : "${WT_IDEA_FILES_BASE:="$HOME/.wt/repos/repo/idea-files"}"

  # Symlink path that points to the currently active worktree (for IDE integration)
  : "${WT_ACTIVE_WORKTREE:="$HOME/Development/java"}"

  # Default primary branch to sync from when creating new worktrees
  : "${WT_BASE_BRANCH:="master"}"

  # Project metadata patterns to preserve across worktrees (space-separated)
  : "${WT_METADATA_PATTERNS:=""}"

  # Repo-root-relative files to copy from the main repo into new worktrees
  # (space-separated, e.g. "user.bazelrc")
  : "${WT_SEED_FILES:=""}"

  # Context name (for display purposes)
  : "${WT_CONTEXT_NAME:=""}"
}

# Load config at source time
wt_read_config || true
wt_apply_default_config

# ─────────────────────────────────────────────────────────────────────────────
# Worktree pointer maintenance
# ─────────────────────────────────────────────────────────────────────────────

# After moving a repo's .git directory to a new location, update
# worktrees' .git files to point to the new .git path.
#
# Each git worktree has a .git FILE (not directory) containing:
#   gitdir: /old/path/.git/worktrees/<name>
#
# After the repo is moved, these pointers become stale. This function
# reads the main repo's .git/worktrees/*/gitdir to find each worktree's
# .git file, then rewrites it to point to the new location.
#
# Args: $1 = repo directory (the new location containing .git/)
#       $2 = mode (optional): "unadopted" (default) - only unadopted worktrees
#                              "adopted"  - only worktrees adopted by context
#                              "all"      - all worktrees unconditionally
#       $3 = context name (optional, used with "adopted" mode)
_wt_update_worktree_pointers() {
  local repo_dir="$1"
  local mode="${2:-unadopted}"
  local context_name="${3:-}"
  local git_dir="$repo_dir/.git"

  [[ -d "$git_dir/worktrees" ]] || return 0

  info "Updating worktree references..."
  for wt_meta_dir in "$git_dir"/worktrees/*/; do
    [[ -d "$wt_meta_dir" ]] || continue

    # Read gitdir to find the worktree path
    local gitdir_file="$wt_meta_dir/gitdir"
    [[ -f "$gitdir_file" ]] || continue
    local wt_dot_git
    wt_dot_git="$(cat "$gitdir_file" | tr -d '[:space:]')"
    [[ -f "$wt_dot_git" ]] || continue

    # Check adoption state based on mode.
    # We check the marker directly in the worktree metadata dir rather than
    # using wt_is_adopted (which runs git rev-parse) because after a repo
    # move the .git pointers are stale and git operations would fail.
    # The marker lives at <git_dir>/worktrees/<name>/wt/adopted.
    local adopted_marker="$wt_meta_dir/wt/adopted"
    case "$mode" in
      unadopted)
        # Skip adopted worktrees — they already have correct physical paths
        if [[ -f "$adopted_marker" ]]; then
          continue
        fi
        ;;
      adopted)
        # Skip unadopted worktrees and worktrees adopted by other contexts
        if [[ ! -f "$adopted_marker" ]]; then
          continue
        fi
        if [[ -n "$context_name" ]]; then
          local adopted_ctx
          adopted_ctx="$(head -1 "$adopted_marker" 2>/dev/null | tr -d '[:space:]')"
          if [[ -n "$adopted_ctx" && "$adopted_ctx" != "$context_name" ]]; then
            continue
          fi
        fi
        ;;
      all)
        # Update everything
        ;;
    esac

    local wt_name="${wt_meta_dir%/}"
    wt_name="${wt_name##*/}"
    echo "gitdir: ${git_dir}/worktrees/${wt_name}" > "$wt_dot_git"
  done
}

# ─────────────────────────────────────────────────────────────────────────────
# Expand ~ to $HOME in a path (bash doesn't expand ~ in variable assignments
# or interactive read input)
_wt_expand_path() {
  local path="$1"
  [[ "$path" == "~" ]] && path="$HOME"
  echo "${path/#\~\//$HOME/}"
}

# Prune paths where an ancestor is already in the set.
# When metadata patterns nest (e.g., .ijwb contains .idea), only the
# outermost directory needs to be exported/imported — the children are
# already included.
# Reads newline-separated absolute paths from stdin, writes pruned paths to stdout.
_wt_prune_nested_paths() {
  local sorted
  sorted=$(sort)
  local kept_paths=()
  while IFS= read -r _entry_path; do
    [[ -z "$_entry_path" ]] && continue
    local dominated=false
    for kept in ${kept_paths[@]+"${kept_paths[@]}"}; do
      if [[ "$_entry_path" == "$kept/"* ]]; then
        dominated=true
        break
      fi
    done
    if [[ "$dominated" == "false" ]]; then
      kept_paths+=("$_entry_path")
      echo "$_entry_path"
    fi
  done <<< "$sorted"
}

# Build OR'd `find -name` arguments for a space-separated pattern list into
# the global array _WT_METADATA_FIND_NAMES (bash 3.2 cannot return arrays).
# Args: $1 = space-separated patterns
_wt_metadata_find_names() {
  _WT_METADATA_FIND_NAMES=()
  local pattern
  for pattern in $1; do
    if [[ ${#_WT_METADATA_FIND_NAMES[@]} -gt 0 ]]; then
      _WT_METADATA_FIND_NAMES+=(-o)
    fi
    _WT_METADATA_FIND_NAMES+=(-name "$pattern")
  done
}

# Find metadata entries matching WT_METADATA_PATTERNS under a root directory.
# One find traversal with OR'd -name clauses covers all patterns; matches
# both directories and files (e.g. a root-level .bazelproject file); nested
# matches are pruned so only the outermost path per subtree is emitted.
# Scans at most 5 levels deep — the vault mirrors the repo layout, so the
# same depth policy applies to both sides of the export/import round-trip.
# Usage: wt_find_metadata_dirs <root> [--follow]
#   --follow — follow symlinks (for vault scans, where entries are symlinks)
# Outputs: one absolute path per line
wt_find_metadata_dirs() {
  local root="" follow=false arg
  for arg in "$@"; do
    case "$arg" in
      --follow) follow=true ;;
      *) root="$arg" ;;
    esac
  done

  [[ -n "$root" && -d "$root" ]] || return 0

  _wt_metadata_find_names "${WT_METADATA_PATTERNS:-}"
  [[ ${#_WT_METADATA_FIND_NAMES[@]} -eq 0 ]] && return 0

  if [[ "$follow" == true ]]; then
    find -L "$root" -maxdepth 5 \( -type l -o -type d -o -type f \) \
      \( "${_WT_METADATA_FIND_NAMES[@]}" \) 2>/dev/null | _wt_prune_nested_paths
  else
    find "$root" -maxdepth 5 \( -type d -o -type f \) \
      \( "${_WT_METADATA_FIND_NAMES[@]}" \) 2>/dev/null | _wt_prune_nested_paths
  fi
}

# md5 hex digest of a string (the string itself, not a file at that path).
# Args: $1 = string to hash
# Outputs: 32-char hex digest to stdout
# Returns: 0 on success, 1 if no md5 tool is available
_wt_md5_string() {
  local input="$1"
  if command -v md5 >/dev/null 2>&1; then
    md5 -qs "$input"
  elif command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$input" | md5sum | cut -d' ' -f1
  else
    return 1
  fi
}

# Check if a path value is valid for a directory config variable.
# Valid means: absolute path (starts with /) and contains no glob characters.
# Args: $1 = path value
# Returns: 0 if valid, 1 if invalid
_wt_is_valid_path_config() {
  local path="$1"

  # Must be absolute
  [[ "$path" != /* ]] && return 1

  # Must not contain glob metacharacters
  # shellcheck disable=SC2254  # intentional glob check via case pattern
  case "$path" in
    *\**|*\?*|*\[*) return 1 ;;
  esac

  return 0
}

# Validate that a config source actually loaded (WT_CONFIG_SOURCE is set by
# the loaders), that all directory config variables are absolute paths
# without globs, and that WT_MAIN_REPO_ROOT exists and is a git work tree.
# Prints actionable error messages to stderr on failure.
# Returns: 0 if all valid, 1 if any invalid
#
# This is called by bin/wt-* scripts after bootstrap. It is NOT called
# during shell startup (wt.sh sourcing) to avoid breaking the user's shell —
# the fallback defaults from wt_apply_default_config keep the shell usable,
# but they never satisfy this check on their own.
wt_require_valid_config() {
  local rc=0
  local var val

  if [[ -z "${WT_CONFIG_SOURCE:-}" ]]; then
    if [[ -n "${WT_CONTEXT_NAME:-}" ]]; then
      error "No wt configuration loaded — context '$WT_CONTEXT_NAME' has no config at $HOME/.wt/repos/${WT_CONTEXT_NAME}.conf"
    else
      error "No wt configuration loaded — no context is set and this repo has no wt.* git local config"
    fi
    printf "  Run 'wt context add' to configure a repository.\n" >&2
    return 1
  fi

  for var in WT_MAIN_REPO_ROOT WT_WORKTREES_BASE WT_IDEA_FILES_BASE; do
    eval "val=\"\${$var:-}\""
    if [[ -z "$val" ]]; then
      continue  # empty/unset — fallback defaults handle this
    fi
    if ! _wt_is_valid_path_config "$val"; then
      error "$var must be an absolute path (no globs): $val"
      rc=1
    fi
  done

  if [[ $rc -eq 0 ]]; then
    if [[ ! -d "${WT_MAIN_REPO_ROOT:-}" ]]; then
      error "WT_MAIN_REPO_ROOT does not exist: ${WT_MAIN_REPO_ROOT:-}"
      rc=1
    elif ! git -C "$WT_MAIN_REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      error "WT_MAIN_REPO_ROOT is not a git repository or worktree: $WT_MAIN_REPO_ROOT"
      rc=1
    fi
  fi

  if [[ $rc -ne 0 ]]; then
    local config_file=""
    if [[ -n "${WT_CONTEXT_NAME:-}" ]]; then
      config_file="$HOME/.wt/repos/${WT_CONTEXT_NAME}.conf"
    fi
    if [[ -n "$config_file" && -f "$config_file" ]]; then
      printf "  Fix the value(s) in: %s (or run 'wt context add')\n" "$config_file" >&2
    else
      printf "  Check your context config or git local config (wt.* keys), or run 'wt context add'\n" >&2
    fi
  fi

  return $rc
}

# ─────────────────────────────────────────────────────────────────────────────
# Color support (only if output is a TTY)
# ─────────────────────────────────────────────────────────────────────────────
# Check if either stdout or stderr is a TTY (for interactive use)
# Use $'...' syntax to ensure escape sequences are properly interpreted
if [[ -t 1 || -t 2 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  BLUE=$'\033[0;34m'
  BOLD=$'\033[1m'
  NC=$'\033[0m' # No Color
else
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  BOLD=''
  NC=''
fi

# ─────────────────────────────────────────────────────────────────────────────
# Output helpers
# ─────────────────────────────────────────────────────────────────────────────

# Print to stderr (for UI messages, prompts, etc.)
echoerr() {
  printf "%s\n" "$*" >&2
}

# Print error message with red "Error:" prefix to stderr
error() {
  printf "${RED}Error:${NC} %s\n" "$*" >&2
}

# Print success message with green checkmark to stdout
success() {
  printf "${GREEN}✓${NC} %s\n" "$*"
}

# Print warning message with yellow warning symbol to stderr
warn() {
  printf "${YELLOW}⚠${NC}  %s\n" "$*" >&2
}

# Print info message with blue info symbol to stdout
info() {
  printf "${BLUE}ℹ${NC}  %s\n" "$*"
}

# Show the context banner if contexts are configured
# Output goes to stderr so it doesn't interfere with command output
wt_show_context_banner() {
  local repos_dir="$HOME/.wt/repos"

  # Only show banner if contexts are configured
  if [[ ! -d "$repos_dir" ]] || ! compgen -G "$repos_dir/*.conf" >/dev/null 2>&1; then
    return 0
  fi

  # Use WT_CONTEXT_NAME (set by wt_read_config at source time).
  # Falls back to ~/.wt/current for edge cases where config hasn't loaded yet.
  local current_context="${WT_CONTEXT_NAME:-}"
  if [[ -z "$current_context" && -f "$HOME/.wt/current" ]]; then
    current_context="$(head -1 "$HOME/.wt/current" | tr -d '[:space:]')"
  fi

  if [[ -n "$current_context" ]]; then
    if [[ "$(git config --local --get wt.enabled 2>/dev/null)" == "true" ]]; then
      printf "${BLUE}[Context: %s 📌]${NC}\n" "$current_context" >&2
    else
      printf "${BLUE}[Context: %s]${NC} ${YELLOW}(wt context to switch)${NC}\n" "$current_context" >&2
    fi
  else
    printf "%s[No context set]%s %s(wt context to switch)%s\n" "$YELLOW" "$NC" "$YELLOW" "$NC" >&2
  fi
}

# Source a library script from lib/ directory
# Usage: wt_source <script_name>
# Uses LIB_DIR when set by the calling script (usually SCRIPT_DIR/../lib),
# falling back to ~/.wt/lib otherwise
wt_source() {
  local script="$1"
  local lib_dir="${LIB_DIR:-$HOME/.wt/lib}"

  if [[ -f "$lib_dir/$script" ]]; then
    . "$lib_dir/$script"
  elif [[ -f "$HOME/.wt/lib/$script" ]]; then
    . "$HOME/.wt/lib/$script"
  else
    echo "Error: Cannot find $script in $lib_dir or ~/.wt/lib/" >&2
    return 1
  fi
}

# Locate a wt executable by name.
# Search order: $SCRIPT_DIR, $BIN_DIR, ~/.wt/bin, then PATH.
# Usage: wt_find_bin <name>
# Outputs: executable path (or bare name if resolved via PATH) to stdout
# Returns: 0 if found, 1 if not
wt_find_bin() {
  local name="$1"

  if [[ -n "${SCRIPT_DIR:-}" && -x "$SCRIPT_DIR/$name" ]]; then
    printf '%s\n' "$SCRIPT_DIR/$name"
  elif [[ -n "${BIN_DIR:-}" && -x "$BIN_DIR/$name" ]]; then
    printf '%s\n' "$BIN_DIR/$name"
  elif [[ -x "$HOME/.wt/bin/$name" ]]; then
    printf '%s\n' "$HOME/.wt/bin/$name"
  elif command -v "$name" >/dev/null 2>&1; then
    printf '%s\n' "$name"
  else
    return 1
  fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Git helpers
# ─────────────────────────────────────────────────────────────────────────────

# Enumerate all registered worktrees in a single `git worktree list --porcelain`
# pass. Emits one tab-separated line per worktree:
#   <path>\t<kind>\t<branch>
#     path   — physical absolute path (pwd -P); the raw registered path is
#              passed through when the directory is missing or with --raw
#     kind   — "branch" or "detached"
#     branch — short branch name (refs/heads/ stripped), empty when detached
# branch must stay the LAST field: tab is IFS whitespace, so `IFS=$'\t' read`
# would silently swallow an empty field anywhere but the end of the line.
# Usage: wt_worktree_entries [--raw] [repo_root]
#   --raw     skip physical path resolution (no per-entry subshell forks)
#   repo_root repository to enumerate (default: WT_MAIN_REPO_ROOT)
wt_worktree_entries() {
  local resolve=true repo="${WT_MAIN_REPO_ROOT:-.}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --raw) resolve=false ;;
      *) repo="$1" ;;
    esac
    shift
  done

  local line wt_path="" branch="" kind="" out_path
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        wt_path="${line#worktree }"
        branch=""
        kind="branch"
        ;;
      branch\ *)
        branch="${line#branch refs/heads/}"
        ;;
      detached)
        kind="detached"
        ;;
      "")
        [[ -n "$wt_path" ]] || continue
        out_path="$wt_path"
        if [[ "$resolve" == true && -d "$wt_path" ]]; then
          out_path="$(cd "$wt_path" 2>/dev/null && pwd -P)" || out_path="$wt_path"
        fi
        printf '%s\t%s\t%s\n' "$out_path" "$kind" "$branch"
        wt_path=""
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain 2>/dev/null; echo)
}

# Check whether a directory is the root of a worktree registered with the main
# repo (the main repo itself counts). Compares physical paths (pwd -P) so
# symlinked spellings like macOS /var -> /private/var still match.
# Usage: wt_is_worktree_root <path>
# Returns: 0 if the path is a registered worktree root, 1 otherwise
wt_is_worktree_root() {
  local candidate
  candidate="$(cd "$1" 2>/dev/null && pwd -P)" || return 1

  # Capture before looping: returning early from a < <(...) loop EPIPEs the
  # producer's printf when SIGPIPE is ignored (as on GitHub CI runners).
  local entries wt_abs
  entries="$(wt_worktree_entries)"
  while IFS=$'\t' read -r wt_abs _ _; do
    if [[ "$wt_abs" == "$candidate" ]]; then
      return 0
    fi
  done <<< "$entries"

  return 1
}

# Resolve a worktree identifier (path or branch name) to an absolute worktree path.
# Tries:
#   1. Filesystem path — accepted only if the directory is a registered worktree root
#   2. Exact branch name match via `git worktree list --porcelain`
# Note: Detached HEAD worktrees cannot be resolved by branch name; use the path instead.
# Usage: wt_resolve_worktree <identifier>
# Outputs: absolute path on stdout
# Returns: 0 on success, 1 if not found
wt_resolve_worktree() {
  local identifier="$1"

  # 1) Try as filesystem path
  if [[ -d "$identifier" ]] && wt_is_worktree_root "$identifier"; then
    (cd "$identifier" && pwd)
    return 0
  fi

  # 2) Try as exact branch name
  local entries wt_abs kind branch
  entries="$(wt_worktree_entries)"
  while IFS=$'\t' read -r wt_abs kind branch; do
    if [[ "$kind" == "branch" && "$branch" == "$identifier" && -d "$wt_abs" ]]; then
      printf '%s\n' "$wt_abs"
      return 0
    fi
  done <<< "$entries"

  return 1
}

# Resolve a worktree identifier and validate it's a git worktree.
# Combines wt_resolve_worktree + git-worktree validation.
# Usage: wt_resolve_and_validate <identifier>
# Outputs: absolute path on stdout
# Returns: 0 on success, 1 on failure (with error message on stderr)
wt_resolve_and_validate() {
  local identifier="$1"
  local resolved
  if ! resolved="$(wt_resolve_worktree "$identifier")"; then
    if [[ -d "$identifier" ]]; then
      resolved="$(cd "$identifier" 2>/dev/null && pwd)" || resolved="$identifier"
      error "$resolved is not a git repository or worktree registered in $WT_MAIN_REPO_ROOT"
    else
      error "Worktree not found (not a valid path or branch name): $identifier"
    fi
    return 1
  fi
  if ! git -C "$resolved" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    error "$resolved is not a git repository or worktree"
    return 1
  fi
  printf '%s\n' "$resolved"
}

# List branch names of active worktrees.
# Usage: wt_worktree_branch_list [exclude_main]
# Outputs: one branch name per line to stdout
# Note: Detached HEAD worktrees are excluded (no branch name to emit).
wt_worktree_branch_list() {
  local exclude_main="${1:-}"
  local main_repo_abs="" mode="--raw"

  # Physical paths are only needed to compare against the main repo; the
  # completion hot path (no exclude_main) stays fork-free via --raw.
  if [[ "$exclude_main" == "exclude_main" && -n "${WT_MAIN_REPO_ROOT:-}" ]]; then
    main_repo_abs="$(cd "$WT_MAIN_REPO_ROOT" 2>/dev/null && pwd -P)" || main_repo_abs=""
    [[ -n "$main_repo_abs" ]] && mode=""
  fi

  local wt_abs kind branch
  while IFS=$'\t' read -r wt_abs kind branch; do
    [[ "$kind" == "branch" && -n "$branch" ]] || continue
    [[ -d "$wt_abs" ]] || continue
    [[ -n "$main_repo_abs" && "$wt_abs" == "$main_repo_abs" ]] && continue
    printf '%s\n' "$branch"
  done < <(wt_worktree_entries ${mode:+"$mode"})
}

# List absolute paths of all registered worktrees (including the main repo).
# Usage: _wt_worktree_list
# Outputs: one worktree path per line to stdout
_wt_worktree_list() {
  local wt_path
  while IFS=$'\t' read -r wt_path _ _; do
    printf '%s\n' "$wt_path"
  done < <(wt_worktree_entries --raw)
}

# Get the currently linked worktree path (resolves symlink)
# Usage: wt_get_linked_worktree
# Outputs: absolute physical path to linked worktree, or empty if none
#
# Returns physical paths (pwd -P) to ensure consistent comparison with
# git worktree list output, which also uses physical paths. This handles
# macOS symlink quirks like /var -> /private/var.
wt_get_linked_worktree() {
  local link_path="$WT_ACTIVE_WORKTREE"

  # Normalize link path to physical path for consistent comparison
  if [[ -d "$(dirname "$link_path")" ]]; then
    link_path="$(_wt_resolve_parent "$link_path")"
  fi

  if [[ -L "$link_path" ]]; then
    _wt_readlink_abs "$link_path" || true
  fi
}

# Build the wt-list/picker adopted-set in one pass over the main repo's
# .git/worktrees metadata — zero git spawns. Each entry's gitdir file holds
# the path of the worktree's .git file; its dirname is the worktree root.
# Adopted marker: wt/adopted alongside the gitdir file.
# Usage: wt_adopted_worktree_paths
# Outputs: one physical absolute worktree path per line
wt_adopted_worktree_paths() {
  local worktrees_dir="${WT_MAIN_REPO_ROOT:-.}/.git/worktrees"
  [[ -d "$worktrees_dir" ]] || return 0

  local meta_dir wt_dot_git wt_root
  for meta_dir in "$worktrees_dir"/*/; do
    [[ -f "$meta_dir/wt/adopted" ]] || continue
    [[ -f "$meta_dir/gitdir" ]] || continue
    wt_dot_git=""
    IFS= read -r wt_dot_git < "$meta_dir/gitdir" || true
    [[ -n "$wt_dot_git" ]] || continue
    wt_root="$(dirname "$wt_dot_git")"
    [[ -d "$wt_root" ]] || continue
    (cd "$wt_root" 2>/dev/null && pwd -P) || continue
  done
  return 0
}

# Check whether <path> appears as an exact line in newline-delimited <lines>.
# Usage: _wt_path_in_lines <path> <lines>
_wt_path_in_lines() {
  case $'\n'"$2"$'\n' in
    *$'\n'"$1"$'\n'*) return 0 ;;
  esac
  return 1
}

# Compute the linked-* prefix and [unadopted] badge for a worktree row
# (shared by wt-list and the interactive picker).
# Usage: wt_worktree_prefix_and_badge <wt_abs> <main_repo_abs> <linked_worktree> <adopted_set>
#   adopted_set — newline-delimited physical paths from wt_adopted_worktree_paths
# Sets: WT_ROW_PREFIX — "* " (green) when linked, "  " otherwise
#       WT_ROW_BADGE  — "[unadopted] " (red when linked, yellow otherwise) or ""
# shellcheck disable=SC2034  # WT_ROW_* are read by callers in other files
wt_worktree_prefix_and_badge() {
  local wt_abs="$1"
  local main_repo_abs="$2"
  local linked_worktree="$3"
  local adopted_set="${4:-}"

  local is_linked=false
  WT_ROW_PREFIX="  "
  WT_ROW_BADGE=""

  if [[ -n "$linked_worktree" && "$wt_abs" == "$linked_worktree" ]]; then
    is_linked=true
    WT_ROW_PREFIX="${GREEN}*${NC} "
  fi

  # Adoption doesn't apply to the main repo
  if [[ "$wt_abs" != "$main_repo_abs" ]] && ! _wt_path_in_lines "$wt_abs" "$adopted_set"; then
    if [[ "$is_linked" == true ]]; then
      WT_ROW_BADGE="${RED}[unadopted]${NC} "
    else
      WT_ROW_BADGE="${YELLOW}[unadopted]${NC} "
    fi
  fi
}

# Probe one worktree's dirty/ahead/behind state.
# --no-optional-locks keeps the status probe from contending with IDE index
# refreshes; pass an empty branch (e.g. detached HEAD) to skip ahead/behind.
# Usage: wt_status_probe <worktree_path> [branch]
# Outputs lines (in this order, each only when applicable):
#   dirty
#   ahead N
#   behind N
wt_status_probe() {
  local wt_abs="$1"
  local branch="${2:-}"

  local status
  status="$(git --no-optional-locks -C "$wt_abs" status --porcelain 2>/dev/null || true)"
  [[ -n "$status" ]] && echo "dirty"

  if [[ -n "$branch" ]]; then
    local upstream
    upstream="$(git --no-optional-locks -C "$wt_abs" rev-parse --abbrev-ref "@{upstream}" 2>/dev/null || true)"
    if [[ -n "$upstream" ]]; then
      local counts
      counts="$(git --no-optional-locks -C "$wt_abs" rev-list --left-right --count "$branch...$upstream" 2>/dev/null || true)"
      if [[ -n "$counts" ]]; then
        local ahead behind
        IFS=$'\t' read -r ahead behind <<< "$counts"
        [[ "$ahead" -gt 0 ]] && echo "ahead $ahead"
        [[ "$behind" -gt 0 ]] && echo "behind $behind"
      fi
    fi
  fi
  return 0
}

# Run wt_status_probe for many worktrees concurrently in a bounded job pool,
# writing each result to <dir>/<index>. All jobs finish before this returns,
# so callers read results in original entry order regardless of completion
# order; wall time is roughly max(probe) instead of sum(probe).
# Input (stdin): index<TAB>path<TAB>branch lines (branch empty to skip
# ahead/behind).
# Usage: wt_run_status_probes <dir> < input
wt_run_status_probes() {
  local dir="$1"
  local max_jobs="${WT_STATUS_PROBE_JOBS:-6}"
  # Pattern check, not [[ -ge ]]: a non-numeric value in an arithmetic test
  # is a fatal nounset error in bash 3.2 that || cannot catch
  case "$max_jobs" in
    ''|0|*[!0-9]*) max_jobs=6 ;;
  esac

  local idx path branch pid
  local pids=()
  while IFS=$'\t' read -r idx path branch; do
    [[ -n "$idx" ]] || continue
    if [[ "${#pids[@]}" -ge "$max_jobs" ]]; then
      wait "${pids[0]}" 2>/dev/null || true
      pids=(${pids[@]+"${pids[@]:1}"})
    fi
    wt_status_probe "$path" "$branch" > "$dir/$idx" 2>/dev/null </dev/null &
    pids+=("$!")
  done

  for pid in ${pids[@]+"${pids[@]}"}; do
    wait "$pid" 2>/dev/null || true
  done
  return 0
}

# Format a worktree entry for display
# Usage: wt_format_worktree <worktree_path> [main_repo_abs] [linked_worktree] [verbose] [branch] [probe_result]
# Outputs: formatted string like "~/path (branch) [main] [linked] [dirty] [↑N] [↓N]"
# When verbose is "true", includes slow status checks (dirty, ahead/behind)
# When branch is given (e.g. from wt_worktree_entries), no git process is
# spawned to derive it; pass "HEAD" for detached HEAD worktrees to match
# what `git rev-parse --abbrev-ref HEAD` would print.
# When probe_result is given (wt_status_probe output collected up front, e.g.
# concurrently via wt_run_status_probes), the verbose path spawns no git
# processes at all; otherwise it probes the worktree itself.
wt_format_worktree() {
  local wt_abs="$1"
  local main_repo_abs="${2:-}"
  local linked_worktree="${3:-}"
  local verbose="${4:-false}"
  local branch="${5:-}"

  if [[ -z "$branch" ]]; then
    branch="$(git -C "$wt_abs" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "detached")"
  fi

  # Build indicator string
  local indicators=""

  # Check if this is the main repo (fast - just string compare)
  if [[ -n "$main_repo_abs" && "$wt_abs" == "$main_repo_abs" ]]; then
    indicators="${indicators}${YELLOW}[main]${NC} "
  fi

  # Check if this is the currently linked worktree (fast - just string compare)
  if [[ -n "$linked_worktree" && "$wt_abs" == "$linked_worktree" ]]; then
    indicators="${indicators}${GREEN}[linked]${NC} "
  fi

  # Slow status checks - only when verbose mode is enabled
  if [[ "$verbose" == "true" ]]; then
    local probe
    if [[ $# -ge 6 ]]; then
      probe="$6"
    else
      local probe_branch="$branch"
      case "$branch" in detached|HEAD) probe_branch="" ;; esac
      probe="$(wt_status_probe "$wt_abs" "$probe_branch")"
    fi

    local probe_line
    while IFS= read -r probe_line; do
      case "$probe_line" in
        dirty)     indicators="${indicators}${RED}[dirty]${NC} " ;;
        ahead\ *)  indicators="${indicators}${GREEN}[↑${probe_line#ahead }]${NC} " ;;
        behind\ *) indicators="${indicators}${YELLOW}[↓${probe_line#behind }]${NC} " ;;
      esac
    done <<< "$probe"
  fi

  # Output formatted entry
  printf "${BOLD}%s${NC} ${BLUE}(%s)${NC} %s" "$wt_abs" "$branch" "$indicators"
}

# ─────────────────────────────────────────────────────────────────────────────
# Porcelain listing
# ─────────────────────────────────────────────────────────────────────────────

# Output augmented porcelain listing of all worktrees.
# Passes through all native `git worktree list --porcelain` lines verbatim,
# then appends wt.* lines per entry before the blank separator.
#
# wt-specific lines:
#   wt.active   — this worktree is the WT_ACTIVE_WORKTREE symlink target
#   wt.adopted  — the adoption marker file exists
#   wt.dirty    — has uncommitted changes (only with --verbose)
#   wt.ahead N  — N commits ahead of upstream (only with --verbose)
#   wt.behind N — N commits behind upstream (only with --verbose)
#
# Usage: wt_list_porcelain [--verbose]
# Outputs: augmented porcelain to stdout
wt_list_porcelain() {
  local verbose=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose) verbose=true ;;
      *) ;;
    esac
    shift
  done

  # Pre-resolve paths for comparison
  local main_repo_abs
  main_repo_abs="$(cd "$WT_MAIN_REPO_ROOT" && pwd -P)" || return 1

  local active_worktree
  active_worktree="$(wt_get_linked_worktree)"

  # The main repo's adoption marker lives at .git/wt/adopted, not under
  # .git/worktrees, so it is checked separately below.
  local adopted_set
  adopted_set="$(wt_adopted_worktree_paths)"

  local porcelain
  porcelain="$(git -C "$main_repo_abs" worktree list --porcelain)" || return 1

  # Verbose: probe every worktree concurrently up front, keyed by entry index
  # (both passes count `worktree ` lines, so indices always line up).
  local probe_dir=""
  if [[ "$verbose" == true ]]; then
    probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/wt-porcelain.XXXXXX")" || return 1
    local probe_input="" p_idx=-1 p_path="" p_branch="" p_detached=false p_line
    while IFS= read -r p_line || [[ -n "$p_line" ]]; do
      case "$p_line" in
        worktree\ *)
          p_path="${p_line#worktree }"
          p_branch=""
          p_detached=false
          p_idx=$((p_idx + 1))
          ;;
        branch\ *)
          p_branch="${p_line#branch refs/heads/}"
          ;;
        detached)
          p_detached=true
          ;;
        "")
          if [[ -n "$p_path" && -d "$p_path" ]]; then
            [[ "$p_detached" == true ]] && p_branch=""
            probe_input="${probe_input}${p_idx}"$'\t'"${p_path}"$'\t'"${p_branch}"$'\n'
          fi
          p_path=""
          ;;
      esac
    done <<< "$porcelain"$'\n'
    wt_run_status_probes "$probe_dir" <<< "$probe_input"
  fi

  local line wt_path=""
  local in_entry=false entry_index=-1

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      # End of entry — append wt.* lines, then blank separator
      if [[ "$in_entry" == true ]]; then
        local wt_abs
        wt_abs="$(cd "$wt_path" 2>/dev/null && pwd -P)" || { echo; in_entry=false; continue; }

        # wt.active
        if [[ -n "$active_worktree" && "$wt_abs" == "$active_worktree" ]]; then
          echo "wt.active"
        fi

        # wt.adopted
        if [[ "$wt_abs" == "$main_repo_abs" ]]; then
          [[ -f "$WT_MAIN_REPO_ROOT/.git/wt/adopted" ]] && echo "wt.adopted"
        elif _wt_path_in_lines "$wt_abs" "$adopted_set"; then
          echo "wt.adopted"
        fi

        # Verbose: dirty, ahead/behind
        if [[ "$verbose" == true ]]; then
          local probe=""
          [[ -f "$probe_dir/$entry_index" ]] && probe="$(cat "$probe_dir/$entry_index")"
          local probe_line
          while IFS= read -r probe_line; do
            case "$probe_line" in
              dirty)     echo "wt.dirty" ;;
              ahead\ *)  echo "wt.ahead ${probe_line#ahead }" ;;
              behind\ *) echo "wt.behind ${probe_line#behind }" ;;
            esac
          done <<< "$probe"
        fi

        echo  # blank separator
        in_entry=false
      fi
      continue
    fi

    case "$line" in
      worktree\ *)
        wt_path="${line#worktree }"
        in_entry=true
        entry_index=$((entry_index + 1))
        echo "$line"
        ;;
      *)
        # Pass through HEAD, branch, detached, bare, locked, prunable, etc.
        echo "$line"
        ;;
    esac
  done <<< "$porcelain"$'\n'
  # The appended newline restores the final blank line that "$( )" stripped,
  # so the last entry is flushed.

  [[ -n "$probe_dir" ]] && rm -rf "$probe_dir"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# Worktree status helpers
# ─────────────────────────────────────────────────────────────────────────────

# Check if a worktree has uncommitted changes
# Usage: wt_has_uncommitted_changes <worktree-path>
# Returns: 0 if uncommitted changes exist, 1 if clean
wt_has_uncommitted_changes() {
  local worktree="$1"

  if [[ ! -d "$worktree" ]]; then
    return 1
  fi

  # Check for uncommitted changes (staged + unstaged + untracked)
  local status
  status="$(git -C "$worktree" status --porcelain 2>/dev/null)"

  if [[ -n "$status" ]]; then
    return 0  # Has uncommitted changes
  else
    return 1  # Clean
  fi
}

# Get summary of uncommitted changes in a worktree
# Usage: wt_uncommitted_summary <worktree-path>
# Outputs summary to stdout
wt_uncommitted_summary() {
  local worktree="$1"
  local staged unstaged untracked

  staged=$(git -C "$worktree" diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')
  unstaged=$(git -C "$worktree" diff --numstat 2>/dev/null | wc -l | tr -d ' ')
  untracked=$(git -C "$worktree" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')

  local parts=()
  [[ "$staged" -gt 0 ]] && parts+=("$staged staged")
  [[ "$unstaged" -gt 0 ]] && parts+=("$unstaged modified")
  [[ "$untracked" -gt 0 ]] && parts+=("$untracked untracked")

  if [[ ${#parts[@]} -gt 0 ]]; then
    echo "${parts[*]}"
  fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Symlink helpers
# ─────────────────────────────────────────────────────────────────────────────

# Atomically create or replace a symlink at link_path pointing to target.
# Uses create-temp-then-rename so the symlink is never absent.

wt_atomic_symlink() {
  local target="$1" link_path="$2"
  local parent tmp_link mv_err

  parent="$(dirname "$link_path")" || return 1

  if [[ -e "$link_path" && ! -L "$link_path" ]]; then
    error "Refusing to replace non-symlink at $link_path"
    return 1
  fi

  mkdir -p "$parent" || return 1

  tmp_link="${link_path}.wt-tmp.$$.$RANDOM"
  ln -s "$target" "$tmp_link" || {
    rm -f "$tmp_link"
    return 1
  }

  if mv_err="$(mv -fT "$tmp_link" "$link_path" 2>&1)"; then
    return 0
  fi

  if mv_err="$(mv -fh "$tmp_link" "$link_path" 2>&1)"; then
    return 0
  fi

  printf '%s\n' "$mv_err" >&2
  rm -f "$tmp_link"
  return 1
}

# ═══════════════════════════════════════════════════════════════════════════════
# Prompts
# ═══════════════════════════════════════════════════════════════════════════════

# Prompt for confirmation with Ctrl-C handling
# Args:
#   $1 = prompt message (without trailing space)
#   $2 = default behavior: "y" (default yes), "n" (default no), or "" (require input)
# Returns:
#   0 if confirmed, 1 if declined or Ctrl-C
# Example:
#   if prompt_confirm "Proceed with operation? [Y/n]" "y"; then ...
#   if prompt_confirm "Delete everything? [y/N]" "n"; then ...
prompt_confirm() {
  local prompt="$1"
  local default="${2:-}"
  local response

  if ! read -erp "$prompt " response; then
    # Ctrl-C or EOF
    echo
    return 1
  fi

  # Empty response uses default
  if [[ -z "$response" ]]; then
    response="$default"
  fi

  case "$response" in
    [yY]|[yY][eE][sS])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}
