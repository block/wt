#!/usr/bin/env bash
#
# wt-adopt — Adoption helpers for worktree management
# ====================================================
#
# Provides functions for adopting existing worktrees into wt management.
# "Adopting" means: importing metadata, seeding configured root files, and
# placing a marker file so wt knows this worktree is managed.
#
# Marker file location:
#   $(git rev-parse --git-dir)/wt/adopted
#
# This resolves to:
#   - .git/worktrees/<name>/wt/adopted  (for worktrees)
#   - .git/wt/adopted                    (for the main repo — but adoption is blocked)
#

# ─────────────────────────────────────────────────────────────────────────────
# Marker file helpers
# ─────────────────────────────────────────────────────────────────────────────

# Check if a worktree has been adopted by wt.
# Args: $1 = worktree path (default: CWD)
# Returns: 0 if adopted, 1 if not
wt_is_adopted() {
  local worktree_path="${1:-.}"
  local git_dir
  git_dir="$(git -C "$worktree_path" rev-parse --git-dir 2>/dev/null)" || return 1

  # Resolve to absolute path
  if [[ "$git_dir" != /* ]]; then
    git_dir="$(_wt_realpath "$worktree_path/$git_dir")"
  fi

  [[ -f "$git_dir/wt/adopted" ]]
}

# Mark a worktree as adopted.
# Args: $1 = worktree path (default: CWD)
# Returns: 0 on success, 1 on failure
wt_mark_adopted() {
  local worktree_path="${1:-.}"
  local git_dir
  git_dir="$(git -C "$worktree_path" rev-parse --git-dir 2>/dev/null)" || return 1

  if [[ "$git_dir" != /* ]]; then
    git_dir="$(_wt_realpath "$worktree_path/$git_dir")"
  fi

  local context="${WT_CONTEXT_NAME:-unknown}"
  mkdir -p "$git_dir/wt"
  echo "$context" > "$git_dir/wt/adopted"
}

# Remove adoption marker from a worktree.
# Args: $1 = worktree path (default: CWD)
# Returns: 0 on success, 1 on failure
wt_unmark_adopted() {
  local worktree_path="${1:-.}"
  local git_dir
  git_dir="$(git -C "$worktree_path" rev-parse --git-dir 2>/dev/null)" || return 1

  if [[ "$git_dir" != /* ]]; then
    git_dir="$(_wt_realpath "$worktree_path/$git_dir")"
  fi

  rm -f "$git_dir/wt/adopted"
  rmdir "$git_dir/wt" 2>/dev/null || true
}

# Read the context name from the adoption marker.
# Args: $1 = worktree path (default: CWD)
# Outputs: context name to stdout (may be empty for old-format files)
# Returns: 0 if adopted (even if context unknown), 1 if not adopted
wt_read_adopted_context() {
  local worktree_path="${1:-.}"
  local git_dir
  git_dir="$(git -C "$worktree_path" rev-parse --git-dir 2>/dev/null)" || return 1

  if [[ "$git_dir" != /* ]]; then
    git_dir="$(_wt_realpath "$worktree_path/$git_dir")"
  fi

  if [[ -f "$git_dir/wt/adopted" ]]; then
    local content
    content="$(head -1 "$git_dir/wt/adopted" | tr -d '[:space:]')"
    if [[ -n "$content" ]]; then
      echo "$content"
    fi
    return 0
  fi

  return 1
}

# Check if a path is the main repository (not a worktree).
# In the main repo, git-dir and git-common-dir resolve to the same place.
# In a worktree, git-dir is .git/worktrees/<name>, common-dir is .git.
# Args: $1 = path (default: CWD)
# Returns: 0 if main repo, 1 if worktree or not a git repo
wt_is_main_repo() {
  local path="${1:-.}"
  local git_dir common_dir
  git_dir="$(git -C "$path" rev-parse --git-dir 2>/dev/null)" || return 1
  common_dir="$(git -C "$path" rev-parse --git-common-dir 2>/dev/null)" || return 1

  # Resolve both to absolute physical paths for comparison
  local abs_git_dir abs_common_dir
  if [[ "$git_dir" == /* ]]; then
    abs_git_dir="$(_wt_realpath "$git_dir")"
  else
    abs_git_dir="$(_wt_realpath "$path/$git_dir")"
  fi
  if [[ "$common_dir" == /* ]]; then
    abs_common_dir="$(_wt_realpath "$common_dir")"
  else
    abs_common_dir="$(_wt_realpath "$path/$common_dir")"
  fi

  [[ "$abs_git_dir" == "$abs_common_dir" ]]
}

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

# Check if the current session is interactive (stdin and stderr are TTYs).
# Extracted as a function so tests can override it.
_wt_is_interactive() { [[ -t 0 && -t 2 ]]; }

# ─────────────────────────────────────────────────────────────────────────────
# Conflict detection
# ─────────────────────────────────────────────────────────────────────────────

# Check for existing files in a worktree that would be overwritten by adoption.
#
# Scans:
#   - The vault (WT_IDEA_FILES_BASE) for metadata matching WT_METADATA_PATTERNS,
#     then checks if the corresponding target paths exist in the worktree.
#     This mirrors the same vault-scanning logic used by wt-metadata-import.
#
# Args: $1 = worktree path (absolute)
# Outputs: conflicting relative paths to stdout (one per line)
# Returns: 0 if conflicts found, 1 if no conflicts
wt_check_adoption_conflicts() {
  local worktree_path="$1"
  local -a conflicts=()
  local vault="${WT_IDEA_FILES_BASE:-}"

  # Check metadata patterns by scanning the vault (same as wt-metadata-import)
  if [[ -n "$vault" && -d "$vault" ]]; then
    local meta_src name parent_src rel_path target_meta
    while IFS= read -r meta_src; do
      [[ -z "$meta_src" ]] && continue

      # Compute relative path from vault root (mirrors import logic)
      name="$(basename "$meta_src")"
      parent_src="$(dirname "$meta_src")"
      rel_path=""
      if [[ "$parent_src" != "$vault" ]]; then
        rel_path="${parent_src#"$vault"/}"
      fi

      # Map to corresponding target in worktree
      if [[ -z "$rel_path" ]]; then
        target_meta="$worktree_path/$name"
      else
        target_meta="$worktree_path/$rel_path/$name"
      fi

      # Check if target already exists
      if [[ -e "$target_meta" || -L "$target_meta" ]]; then
        if [[ -z "$rel_path" ]]; then
          conflicts+=("$name")
        else
          conflicts+=("$rel_path/$name")
        fi
      fi
    done < <(wt_find_metadata_dirs --follow "$vault")
  fi

  if [[ ${#conflicts[@]} -eq 0 ]]; then
    return 1
  fi

  printf '%s\n' "${conflicts[@]}"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# Treatment functions
# ─────────────────────────────────────────────────────────────────────────────

# Copy configured seed files (WT_SEED_FILES) from the main repo into a worktree.
# Best-effort: any failure warns and continues — never fails adoption.
# Never overwrites files that already exist in the worktree.
# Args: $1 = worktree path (absolute)
wt_seed_files() {
  local worktree_path="$1"

  local name src dst
  for name in ${WT_SEED_FILES:-}; do
    src="$WT_MAIN_REPO_ROOT/$name"
    dst="$worktree_path/$name"

    [[ -f "$src" ]] || continue
    [[ -e "$dst" || -L "$dst" ]] && continue

    if cp -p "$src" "$dst" 2>/dev/null; then
      info "  seeded $name"
    else
      warn "Could not seed $name into $worktree_path"
    fi
  done
  return 0
}

# Run the full adoption treatment on a worktree.
# 1. Check for conflicting files (unless --force)
# 2. Import metadata from vault (unless keep_existing)
# 3. Seed configured root files from the main repo (always)
# 4. Place adoption marker
#
# Args: [--force] <worktree_path>
#   --force: skip conflict check (used by wt-add for fresh worktrees)
# Requires: WT_IDEA_FILES_BASE to be set
# Returns: 0 on success, 1 if aborted due to conflicts
wt_adopt_worktree() {
  local worktree_path=""
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true ;;
      *) worktree_path="$1" ;;
    esac
    shift
  done

  local keep_existing=false

  # 1. Conflict check
  if [[ "$force" != true ]]; then
    local conflict_list
    if conflict_list="$(wt_check_adoption_conflicts "$worktree_path")"; then
      warn "The following files in the worktree will be overwritten by adoption:"
      while IFS= read -r item; do
        echo "  - $item" >&2
      done <<< "$conflict_list"
      echo >&2

      if _wt_is_interactive; then
        echo "  [O]verwrite — replace with vault contents" >&2
        echo "  [K]eep     — adopt without importing metadata" >&2
        echo "  [A]bort    — cancel adoption" >&2
        echo >&2

        local response
        if ! read -erp "Choose [O/K/A]: " response; then
          echo >&2
          return 1
        fi

        case "$response" in
          [oO]|[oO][vV]*)
            # Overwrite — proceed with full treatment
            ;;
          [kK]|[kK][eE]*)
            # Keep — skip metadata import
            keep_existing=true
            ;;
          *)
            echo "Aborted." >&2
            return 1
            ;;
        esac
      else
        error "Aborting: worktree has existing files that would be overwritten (use --force to override)"
        return 1
      fi
    fi
  fi

  # 2. Import metadata (unless keeping existing files)
  if [[ "$keep_existing" != true ]]; then
    local metadata_import=""
    metadata_import="$(wt_find_bin wt-metadata-import)" || metadata_import=""

    if [[ -n "$metadata_import" && -d "${WT_IDEA_FILES_BASE:-}" ]]; then
      info "Importing metadata into worktree: $worktree_path"
      if ! "$metadata_import" -y "$WT_IDEA_FILES_BASE" "$worktree_path"; then
        error "Metadata import failed — worktree not adopted"
        return 1
      fi
    fi
  else
    info "Keeping existing metadata files"
  fi

  # 3. Seed root files (always — even with keep_existing; never overwrites)
  wt_seed_files "$worktree_path"

  # 4. Mark as adopted
  wt_mark_adopted "$worktree_path"

  success "Worktree adopted: $worktree_path"
}
